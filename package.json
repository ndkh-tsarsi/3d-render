{
  "name": "cat-defense-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/cat-defense-sdk",
    "apps/defense-portal"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node tools/dev_defense.mjs",
    "dev:game": "node tools/serve_defense.mjs",
    "dev:portal": "npm run dev --workspace=@cat-defense/portal",
    "build:defense": "node tools/build_cat_defense.mjs",
    "build:ready": "python3 tools/build_ready_games.py --replace",
    "build:portal": "npm run build --workspace=@cat-defense/portal",
    "typecheck": "npm run typecheck --workspace=@cat-defense/portal && tsc --project tsconfig.defense-examples.json",
    "test": "node --test tests/*.test.mjs apps/defense-portal/tests/*.test.mjs",
    "test:fixtures": "node tools/capture_game_test_fixtures.mjs --check"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
